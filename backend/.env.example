# Local environment settings template.

# development | testing | staging | production
APP_ENV=development

# Token signing key: at least 32 characters in staging and production.
SECRET_KEY=

# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


# SMS provider: fake or authentica.
SMS_BACKEND=fake

# Authentica credentials and OTP settings.

AUTHENTICA_API_KEY=

AUTHENTICA_TEMPLATE_ID=5

OTP_VALID_SECONDS=300
OTP_MAX_WRONG_TRIES=3
OTP_MAX_SENDS_PER_HOUR=3


# Docker service credentials and published ports.

POSTGRES_USER=tfaqud
POSTGRES_PASSWORD=
POSTGRES_DB=tfaqud

API_PORT=5000

DB_PORT=5433

# Flask connects to the service port, not the published Windows port.
DATABASE_HOST=db
DATABASE_PORT=5432
