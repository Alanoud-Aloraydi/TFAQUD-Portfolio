# Local environment settings template.

# development | testing | staging | production
APP_ENV=development

# Token signing key: at least 32 characters in staging and production.
SECRET_KEY=

# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


# SMS provider: fake or authentica.
SMS_BACKEND=fake

# Authentica credentials and OTP settings.

AUTHENTICA_API_KEY=

AUTHENTICA_TEMPLATE_ID=5

OTP_VALID_SECONDS=300
OTP_MAX_WRONG_TRIES=3
OTP_MAX_SENDS_PER_DAY=20
OTP_RESEND_WAITS=30,60,120,300,600
OTP_MAX_SENDS_PER_DEVICE_HOUR=10
OTP_MAX_SENDS_PER_IP_HOUR=30
# Behind a proxy: the header with the caller's address (Render: CF-Connecting-IP).
CLIENT_IP_HEADER=


# Push notifications: none or apns. apns needs a paid Apple Developer
# account; see "Push notifications" in README.md.
PUSH_BACKEND=none
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# The .p8 key file inside the container, for example /app/secrets/AuthKey_ABC123.p8
APNS_PRIVATE_KEY_PATH=
# production for TestFlight and the App Store; sandbox only for development-signed builds
APNS_ENVIRONMENT=sandbox

# Shared secret the scheduler sends as X-Tick-Secret to POST /internal/tick;
# see "Scheduled notifications" in README.md. Any long random value.
TICK_SECRET=


# Docker service credentials and published ports.

POSTGRES_USER=tfaqud
POSTGRES_PASSWORD=
POSTGRES_DB=tfaqud

API_PORT=5000

DB_PORT=5433

# Flask connects to the service port, not the published Windows port.
DATABASE_HOST=db
DATABASE_PORT=5432
