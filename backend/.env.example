# Template of the settings.

# development | testing | staging | production
APP_ENV=development

# Signs the access tokens. Required (32+ characters) in staging and production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30


SMS_BACKEND=fake

#AUTHENTICA

AUTHENTICA_API_KEY=

AUTHENTICA_TEMPLATE_ID=5

OTP_VALID_SECONDS=300
OTP_MAX_WRONG_TRIES=3
OTP_MAX_SENDS_PER_HOUR=3


# Docker

POSTGRES_USER=tfaqud
POSTGRES_PASSWORD=
POSTGRES_DB=tfaqud

API_PORT=5000

DB_PORT=5432
