# Template of the settings. The app reads real environment variables and does
# not open this file itself.

# development | testing | staging | production
APP_ENV=development

# Signs the access tokens. Required (32+ characters) in staging and production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# fake is the only sender that exists today.
SMS_BACKEND=fake

AUTHENTICA_API_KEY=


POSTGRES_USER=tfaqud
POSTGRES_PASSWORD=
POSTGRES_DB=tfaqud

API_PORT=5000

DB_PORT=5432
